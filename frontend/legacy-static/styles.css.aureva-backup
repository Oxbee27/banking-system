@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* Refined banking interface updates */
.button {
  gap: 8px;
  justify-content: center;
  cursor: pointer;
  transition:
    background 0.18s ease,
    border-color 0.18s ease;
}

.button:hover {
  transform: none;
}

.button-wide {
  justify-content: center;
}

.button:focus-visible,
.text-button:focus-visible,
.nav-item:focus-visible {
  outline: 2px solid var(--green);
  outline-offset: 3px;
}

.button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.action-dialog {
  max-height: min(85vh, 760px);
  overflow-y: auto;
  box-shadow: 0 18px 60px rgba(12, 27, 18, 0.16);
}

.toast {
  z-index: 1000;
  box-shadow: 0 8px 28px rgba(12, 27, 18, 0.15);
}

@media (max-width: 700px) {
  .button-wide {
    width: 100%;
  }
}


/* Account password visibility control */
.password-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.password-input-wrap input {
  padding-right: 65px;
}

.password-toggle {
  position: absolute;
  right: 10px;
  border: 0;
  background: transparent;
  color: var(--green);
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  padding: 8px 5px;
}

.password-toggle:focus-visible {
  outline: 2px solid var(--green);
  outline-offset: 2px;
  border-radius: 3px;
}

.form-stack button:disabled {
  opacity: 0.65;
  cursor: wait;
}

/* Northstar: centered modal interaction system */
.action-dialog {
  position: fixed;
  inset: 50% auto auto 50%;
  transform: translate(-50%, -50%);
  width: min(440px, calc(100vw - 32px));
  max-width: 440px;
  max-height: min(85vh, 760px);
  margin: 0;
  padding: 28px;
  overflow-y: auto;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #ffffff;
  color: var(--ink);
  box-shadow: 0 24px 80px rgba(12, 27, 18, 0.24);
  z-index: 1001;
}

.action-dialog[open] {
  display: block;
}

.action-dialog::backdrop {
  background: rgba(12, 24, 17, 0.58);
  backdrop-filter: blur(3px);
}

.action-dialog form {
  width: 100%;
}

.action-dialog .dialog-actions {
  position: sticky;
  bottom: -28px;
  padding: 16px 0 0;
  background: #ffffff;
}

.toast {
  z-index: 1100;
}

@media (max-width: 600px) {
  .action-dialog {
    width: calc(100vw - 24px);
    max-height: 88dvh;
    padding: 22px;
    border-radius: 9px;
  }

  .action-dialog .dialog-actions {
    bottom: -22px;
  }
}


/* ===================================
   AUREVA MODERN BANKING THEME
=================================== */

:root {
  --green: #f4cb45;
  --green-dark: #d5a91f;
  --ink: #14283b;
  --muted: #74818c;
  --line: #e7e9e6;
  --aureva-navy: #14283b;
  --aureva-yellow: #f4cb45;
  --aureva-teal: #168477;
  --aureva-cream: #f7f7f2;
}

/* Main application */
body {
  background: var(--aureva-cream);
  color: var(--aureva-navy);
  font-family: Inter, "Segoe UI", Arial, sans-serif;
}

/* Workspace */
.workspace,
.dashboard,
.app-shell,
.main-content {
  background: var(--aureva-cream);
}

/* Sidebar */
.sidebar,
.side-nav,
aside {
  background: var(--aureva-navy);
  color: white;
}

.nav-item {
  border-radius: 10px;
  transition: .2s ease;
}

.nav-item:hover {
  background: rgba(244,203,69,.13);
}

.nav-item.active,
.nav-item[aria-current="page"] {
  background: var(--aureva-yellow);
  color: var(--aureva-navy);
  font-weight: 700;
}

/* Branding */
.brand,
.logo,
.brand-name {
  color: var(--aureva-navy);
  font-weight: 800;
  letter-spacing: -.5px;
}

.brand-mark,
.logo-mark {
  background: var(--aureva-yellow);
  color: var(--aureva-navy);
  border-radius: 12px;
}

/* Cards */
.card,
.panel,
.stat-card,
.dashboard-card,
.content-card {
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 16px;
  box-shadow: 0 5px 22px rgba(20,40,59,.045);
}

/* Balance card */
.balance-card,
.balance-panel {
  background: linear-gradient(135deg,#14283b,#203b52);
  color: #fff;
  border: 1px solid rgba(244,203,69,.35);
  border-radius: 18px;
  box-shadow: 0 12px 30px rgba(20,40,59,.15);
}

.balance-card *,
.balance-panel * {
  color: inherit;
}

.balance-card .amount,
.balance-panel .amount {
  color: var(--aureva-yellow);
}

/* Buttons */
.button,
button {
  transition: background .2s ease, border-color .2s ease,
              box-shadow .2s ease;
}

.button-primary,
.button.primary,
button[type="submit"] {
  background: var(--aureva-yellow);
  color: var(--aureva-navy);
  border: 1px solid var(--aureva-yellow);
  border-radius: 10px;
  font-weight: 700;
}

.button-primary:hover,
.button.primary:hover,
button[type="submit"]:hover {
  background: #dfb62e;
  color: var(--aureva-navy);
}

.button-secondary,
.button.secondary {
  background: #fff;
  color: var(--aureva-navy);
  border: 1px solid #dce2e5;
  border-radius: 10px;
}

/* Form fields */
input,
select,
textarea {
  border: 1px solid #dce2e5;
  border-radius: 9px;
  background: #fff;
  color: var(--aureva-navy);
}

input:focus,
select:focus,
textarea:focus {
  outline: none;
  border-color: #d5a91f;
  box-shadow: 0 0 0 3px rgba(244,203,69,.2);
}

/* Login and registration */
.auth-screen,
.auth-page {
  background: linear-gradient(145deg,#14283b,#203d53);
}

.auth-card,
.auth-panel {
  background: #fff;
  border-radius: 18px;
  box-shadow: 0 24px 65px rgba(0,0,0,.2);
}

.auth-tabs button.active,
.auth-tab.active {
  background: var(--aureva-yellow);
  color: var(--aureva-navy);
  font-weight: 700;
}

/* Tables */
th {
  background: #f5f6f3;
  color: var(--aureva-navy);
  font-weight: 700;
}

td,
th {
  border-bottom: 1px solid var(--line);
  padding: 13px 14px;
}

tr:hover td {
  background: #fffdf5;
}

/* Dialogs */
.action-dialog {
  position: fixed;
  inset: 50% auto auto 50%;
  transform: translate(-50%,-50%);
  width: min(440px,calc(100vw - 28px));
  max-height: 85vh;
  margin: 0;
  padding: 26px;
  overflow-y: auto;
  border: 1px solid var(--line);
  border-radius: 16px;
  background: #fff;
  color: var(--aureva-navy);
  box-shadow: 0 24px 80px rgba(12,27,18,.24);
  z-index: 1001;
}

.action-dialog[open] {
  display: block;
}

.action-dialog::backdrop {
  background: rgba(12,24,37,.65);
  backdrop-filter: blur(3px);
}

/* Notifications */
.toast {
  z-index: 1100;
  border-radius: 10px;
  box-shadow: 0 8px 28px rgba(12,27,18,.15);
}

/* Mobile */
@media(max-width:700px) {
  .button-wide {
    width: 100%;
  }

  .action-dialog {
    width: calc(100vw - 24px);
    max-height: 88dvh;
    padding: 21px;
  }
}
