@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap");
:root {
  font-family: "DM Sans", sans-serif;
  color: #1b2821;
  background: #f1f3ef;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  --ink: #1b2821;
  --muted: #727d75;
  --line: #dce2dc;
  --paper: #fbfcf9;
  --canvas: #f1f3ef;
  --green: #174b37;
  --green-dark: #103a2b;
  --mint: #e5eee7;
  --coral: #bd593e;
  --citrus: #d9e977;
}
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background: var(--canvas);
}
button,
input {
  font: inherit;
}
button {
  cursor: pointer;
}
a {
  color: inherit;
  text-decoration: none;
}
.hidden {
  display: none !important;
}
.eyebrow {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #77817c;
}
.brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  font:
    700 19px "DM Sans",
    sans-serif;
  letter-spacing: 0;
}
.brand-mark {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: 3px;
  background: var(--green);
  color: white;
  font:
    500 21px/1 "Newsreader",
    Georgia,
    serif;
}
.auth-layout {
  display: grid;
  grid-template-columns: minmax(360px, 0.92fr) 1.08fr;
  min-height: 100vh;
}
.auth-brand {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 44px clamp(36px, 7vw, 112px);
  color: white;
  background: #173f30;
  position: relative;
  overflow: hidden;
}
.auth-brand .brand-mark {
  background: var(--citrus);
  color: #173f30;
}
.auth-message {
  max-width: 470px;
  margin: auto 0;
  position: relative;
  z-index: 1;
  padding: 72px 0;
}
.auth-message .eyebrow {
  color: #d9e977;
}
.auth-message h1 {
  font:
    400 clamp(50px, 5vw, 72px)/0.99 "Newsreader",
    Georgia,
    serif;
  margin: 18px 0 20px;
  letter-spacing: 0;
}
.auth-message h1 em {
  font-style: normal;
  color: #d9e977;
}
.auth-message p {
  font-size: 16px;
  line-height: 1.7;
  color: #d9ebe0;
  max-width: 360px;
}
.auth-foot {
  font-size: 12px;
  color: #d2e7d8;
  display: flex;
  align-items: center;
  gap: 9px;
}
.signal-dot {
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #62bd81;
  flex: none;
}
.auth-panel {
  display: grid;
  place-items: center;
  padding: 48px 40px;
  background: #f5f6f2;
}
.auth-card {
  width: min(100%, 430px);
  background: transparent;
  padding: 34px 20px;
  border: 0;
  border-radius: 0;
  box-shadow: none;
  animation: rise 0.5s ease both;
}
.mobile-brand {
  display: none;
}
.auth-heading h2 {
  font:
    500 34px/1.05 "Newsreader",
    Georgia,
    serif;
  letter-spacing: 0;
  margin: 12px 0 9px;
}
.auth-heading p,
.dialog-copy {
  font-size: 14px;
  color: var(--muted);
  margin: 0;
  line-height: 1.6;
}
.auth-tabs {
  display: flex;
  gap: 24px;
  padding: 0;
  background: transparent;
  border-bottom: 1px solid var(--line);
  border-radius: 0;
  margin: 28px 0 23px;
}
.auth-tab {
  border: 0;
  border-bottom: 2px solid transparent;
  background: transparent;
  color: #7d867f;
  padding: 10px 0 11px;
  margin-bottom: -1px;
  border-radius: 0;
  font-size: 13px;
  font-weight: 600;
}
.auth-tab.is-active {
  background: transparent;
  border-bottom-color: var(--green);
  color: var(--ink);
  box-shadow: none;
}
.form-stack {
  display: grid;
  gap: 15px;
}
.field {
  display: grid;
  gap: 7px;
  color: #3b4640;
  font-size: 12px;
  font-weight: 600;
}
.field input {
  width: 100%;
  height: 45px;
  padding: 0 13px;
  border: 1px solid #d8dfd9;
  border-radius: 3px;
  background: rgba(255, 255, 255, 0.62);
  color: var(--ink);
  outline: none;
  transition: border-color 0.15s;
}
.field input:focus {
  border-color: #4b9870;
  outline: none;
}
.field input::placeholder {
  color: #a1aaa4;
}
.button {
  min-height: 43px;
  padding: 0 16px;
  border: 1px solid transparent;
  border-radius: 3px;
  font-size: 13px;
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  transition:
    transform 0.15s,
    background 0.15s;
}
.button:hover {
  transform: translateY(-1px);
}
.button-primary {
  background: var(--green);
  color: white;
}
.button-primary:hover {
  background: var(--green-dark);
}
.button-primary:disabled {
  opacity: 0.6;
  cursor: wait;
  transform: none;
}
.button-wide {
  width: 100%;
  min-height: 47px;
  margin-top: 5px;
  justify-content: space-between;
}
.button-quiet {
  border-color: var(--line);
  background: white;
  color: #404b44;
}
.fine-print {
  font-size: 11px;
  color: #9aa29d;
  line-height: 1.6;
  margin: 19px 0 0;
}
.notice {
  padding: 11px 12px;
  border-radius: 5px;
  background: #fff0ed;
  color: #a44734;
  font-size: 12px;
  line-height: 1.5;
}
.workspace {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 244px minmax(0, 1fr);
  background: var(--canvas);
}
.sidebar {
  height: 100vh;
  position: sticky;
  top: 0;
  display: flex;
  flex-direction: column;
  padding: 28px 17px 16px;
  background: #f8f9f6;
  border-right: 1px solid var(--line);
  z-index: 3;
}
.sidebar .brand {
  padding: 0 10px 36px;
}
.side-label {
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1px;
  color: #9ba49e;
  padding: 0 11px 11px;
}
.main-nav {
  display: grid;
  gap: 5px;
}
.nav-item {
  border: 0;
  background: transparent;
  color: #66716a;
  text-align: left;
  padding: 12px 11px;
  border-left: 2px solid transparent;
  border-radius: 2px;
  font-size: 13px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 12px;
}
.nav-item:hover {
  background: #f5f8f5;
  color: var(--ink);
}
.nav-item.is-active {
  background: #e9eee8;
  border-left-color: var(--coral);
  color: var(--green-dark);
}
.nav-icon {
  width: 17px;
  text-align: center;
  font-size: 17px;
  line-height: 1;
}
.sidebar-bottom {
  margin-top: auto;
}
.help-panel {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 13px 10px;
  margin: 10px 0 14px;
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}
.help-icon {
  display: grid;
  place-items: center;
  width: 27px;
  height: 27px;
  border-radius: 50%;
  background: #f0f5f1;
  color: #176c4a;
  font-size: 12px;
  font-weight: 700;
}
.help-panel div {
  display: grid;
  gap: 3px;
  flex: 1;
}
.help-panel strong {
  font-size: 11px;
}
.help-panel div span {
  font-size: 10px;
  color: #8b958e;
}
.help-arrow {
  font-size: 12px;
  color: #8b958e;
}
.profile-button {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 9px 7px;
  border: 0;
  background: transparent;
  text-align: left;
}
.avatar {
  display: grid;
  place-items: center;
  width: 33px;
  height: 33px;
  border-radius: 50%;
  background: #edf2ed;
  color: #356b4d;
  font: 700 12px Manrope;
}
.profile-copy {
  display: grid;
  gap: 3px;
  flex: 1;
  min-width: 0;
}
.profile-copy strong {
  font-size: 11px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-copy small {
  font-size: 10px;
  color: #87918a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.profile-dots {
  font-size: 16px;
  color: #7e8881;
}
.main-column {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 100vh;
}
.topbar {
  height: 67px;
  padding: 0 clamp(22px, 4vw, 62px);
  background: rgba(248, 249, 246, 0.94);
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.breadcrumb {
  font-size: 11px;
  color: #909a93;
}
.breadcrumb span {
  padding: 0 8px;
  color: #b2bab4;
}
.breadcrumb strong {
  color: #39443d;
  font-weight: 600;
}
.topbar-actions {
  display: flex;
  align-items: center;
  gap: 18px;
}
.secure-tag {
  font-size: 10px;
  color: #647169;
  display: flex;
  align-items: center;
  gap: 7px;
}
.icon-button {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 1px solid var(--line);
  background: white;
  border-radius: 5px;
  color: #56625a;
  font-size: 16px;
}
.icon-button:hover {
  background: #f5f8f5;
}
.menu-toggle {
  display: none;
}
.content {
  width: min(1060px, 100%);
  margin: 0 auto;
  padding: 42px clamp(22px, 4vw, 62px) 56px;
  flex: 1;
}
.page-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 27px;
}
.page-head .eyebrow {
  display: block;
  margin-bottom: 8px;
}
.page-head h1 {
  font:
    500 34px/1.05 "Newsreader",
    Georgia,
    serif;
  letter-spacing: 0;
  margin: 0;
}
.page-head p {
  font-size: 13px;
  color: var(--muted);
  margin: 7px 0 0;
}
.balance-panel {
  position: relative;
  overflow: hidden;
  padding: 26px 30px 27px;
  border-radius: 4px;
  color: white;
  background: #173f30;
  border-left: 4px solid var(--citrus);
  box-shadow: none;
  animation: rise 0.45s ease both;
}
.balance-top {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.balance-label {
  font-size: 11px;
  color: #c6e1ce;
}
.balance-chip {
  font-size: 9px;
  color: #d0e8d7;
  border: 1px solid rgba(255, 255, 255, 0.25);
  padding: 6px 8px;
  border-radius: 4px;
}
.balance-amount {
  font:
    500 43px/1 "Newsreader",
    Georgia,
    serif;
  letter-spacing: 0;
  margin: 13px 0 8px;
  position: relative;
  z-index: 1;
}
.balance-account {
  font-size: 11px;
  color: #c4ddcb;
  position: relative;
  z-index: 1;
}
.balance-account strong {
  color: white;
  font-weight: 600;
  margin-left: 7px;
}
.balance-actions {
  display: flex;
  gap: 8px;
  margin-top: 23px;
  position: relative;
  z-index: 1;
}
.balance-actions .button {
  min-height: 36px;
  font-size: 11px;
  padding: 0 13px;
}
.button-light {
  background: #f8fff9;
  color: #16583c;
}
.button-outline-light {
  color: #fff;
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(255, 255, 255, 0.28);
}
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 19px 0 34px;
}
.quick-action {
  min-height: 82px;
  padding: 14px 14px;
  border: 1px solid var(--line);
  border-radius: 3px;
  background: #fbfcf9;
  display: flex;
  align-items: center;
  gap: 12px;
  text-align: left;
  transition:
    transform 0.15s,
    border-color 0.15s;
}
.quick-action:hover {
  transform: none;
  border-color: #c4d8ca;
}
.quick-icon {
  display: grid;
  place-items: center;
  flex: none;
  width: 34px;
  height: 34px;
  border-radius: 6px;
  background: #edf6ef;
  color: #176c4a;
  font-size: 17px;
}
.quick-action strong {
  display: block;
  font-size: 11px;
}
.quick-action small {
  display: block;
  margin-top: 4px;
  font-size: 10px;
  color: #8a948d;
}
.section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin: 0 0 13px;
}
.section-heading h2 {
  font:
    600 21px/1 "Newsreader",
    Georgia,
    serif;
  letter-spacing: 0;
  margin: 0;
}
.text-button {
  border: 0;
  background: transparent;
  color: #176c4a;
  font-size: 11px;
  font-weight: 700;
  padding: 7px 0;
}
.transaction-table {
  width: 100%;
  border-collapse: collapse;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 6px;
  overflow: hidden;
}
.transaction-table th {
  text-align: left;
  padding: 12px 16px;
  background: #fbfcfb;
  color: #8c968f;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.6px;
  font-weight: 700;
  border-bottom: 1px solid var(--line);
}
.transaction-table td {
  padding: 14px 16px;
  border-bottom: 1px solid #edf0ed;
  font-size: 11px;
  color: #47524b;
}
.transaction-table tr:last-child td {
  border-bottom: 0;
}
.transaction-name {
  display: flex;
  align-items: center;
  gap: 10px;
}
.transaction-symbol {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  background: #f0f5f1;
  color: #397450;
  font-size: 13px;
}
.transaction-name strong {
  display: block;
  color: #26312a;
  font-size: 11px;
}
.transaction-name small {
  display: block;
  margin-top: 3px;
  color: #98a19b;
  font-size: 9px;
}
.amount-positive {
  color: #176c4a !important;
  font-weight: 700;
}
.amount-negative {
  color: #29342d !important;
  font-weight: 700;
}
.status-pill {
  display: inline-block;
  padding: 5px 7px;
  border-radius: 2px;
  background: #e7eee7;
  color: #285d43;
  font-size: 9px;
  font-weight: 700;
  text-transform: capitalize;
}
.empty-state {
  padding: 38px 18px;
  text-align: center;
  color: #89938c;
  background: #fff;
  border: 1px solid var(--line);
  border-radius: 6px;
  font-size: 12px;
}
.empty-state strong {
  display: block;
  color: #39443d;
  margin-bottom: 6px;
}
.two-col {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(230px, 0.8fr);
  gap: 16px;
}
.surface {
  border: 1px solid var(--line);
  border-radius: 6px;
  background: white;
  padding: 20px;
}
.surface h2 {
  font:
    600 21px/1 "Newsreader",
    Georgia,
    serif;
  letter-spacing: 0;
  margin: 0;
}
.surface-intro {
  font-size: 11px;
  color: var(--muted);
  margin: 7px 0 17px;
  line-height: 1.6;
}
.account-detail {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  padding: 12px 0;
  border-bottom: 1px solid #edf0ed;
  font-size: 11px;
}
.account-detail:last-child {
  border-bottom: 0;
}
.account-detail span {
  color: #849088;
}
.account-detail strong {
  font-weight: 600;
  text-align: right;
}
.detail-stack {
  display: grid;
}
.action-dialog {
  width: min(440px, calc(100% - 28px));
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 26px;
  background: #fff;
  box-shadow: none;
}
.action-dialog::backdrop {
  background: rgba(12, 27, 18, 0.43);
}
.dialog-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.dialog-close {
  font-size: 20px;
}
.action-dialog h2 {
  font:
    600 27px/1.05 "Newsreader",
    Georgia,
    serif;
  letter-spacing: 0;
  margin: 9px 0;
}
.dialog-copy {
  margin-bottom: 22px;
}
.dialog-actions {
  display: flex;
  justify-content: flex-end;
  gap: 9px;
  margin-top: 22px;
}
.dialog-actions .button {
  min-width: 90px;
}
.app-footer {
  height: 46px;
  padding: 0 clamp(22px, 4vw, 62px);
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: #9aa39c;
  font-size: 9px;
}
.app-footer > span:last-child {
  display: flex;
  align-items: center;
  gap: 7px;
}
.toast {
  position: fixed;
  right: 24px;
  bottom: 25px;
  z-index: 10;
  max-width: min(380px, calc(100% - 32px));
  padding: 13px 16px;
  border-radius: 5px;
  color: white;
  background: #24372b;
  box-shadow: none;
  font-size: 12px;
  opacity: 0;
  transform: translateY(8px);
  pointer-events: none;
  transition: 0.2s;
}
.toast.is-visible {
  opacity: 1;
  transform: translateY(0);
}
.toast.is-error {
  background: #9c4635;
}
.admin-highlight {
  border-left: 3px solid #d4a84d;
}
.chart-wrap {
  height: 155px;
  margin-top: 10px;
  position: relative;
}
.chart-wrap svg {
  width: 100%;
  height: 100%;
  overflow: visible;
}
.chart-grid {
  stroke: #e8ede9;
  stroke-width: 1;
}
.chart-line {
  fill: none;
  stroke: #238254;
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.chart-area {
  fill: url(#areaFill);
}
.chart-note {
  font-size: 9px;
  color: #89938c;
  display: flex;
  justify-content: space-between;
  margin-top: 6px;
}
.activity-filter {
  display: flex;
  gap: 5px;
}
.filter-button {
  border: 1px solid var(--line);
  background: white;
  border-radius: 4px;
  padding: 7px 10px;
  color: #77817c;
  font-size: 10px;
}
.filter-button.is-active {
  background: #eaf4ed;
  border-color: #eaf4ed;
  color: #176c4a;
  font-weight: 700;
}
.page-enter {
  animation: rise 0.28s ease both;
}
@keyframes rise {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@media (max-width: 950px) {
  .workspace {
    grid-template-columns: 210px minmax(0, 1fr);
  }
  .sidebar {
    padding-inline: 12px;
  }
  .quick-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .two-col {
    grid-template-columns: 1fr;
  }
  .auth-layout {
    grid-template-columns: minmax(300px, 0.85fr) 1.15fr;
  }
  .auth-card {
    padding: 32px;
  }
}
@media (max-width: 700px) {
  .auth-layout {
    display: block;
    min-height: 100svh;
    background: #f4f7f3;
  }
  .auth-brand {
    display: none;
  }
  .auth-panel {
    min-height: 100svh;
    padding: 22px;
    background: #f1f3ef;
  }
  .auth-card {
    padding: 24px 20px;
    width: min(100%, 420px);
    box-shadow: none;
  }
  .mobile-brand {
    display: flex;
    margin-bottom: 42px;
  }
  .auth-heading h2 {
    font-size: 22px;
  }
  .workspace {
    display: block;
  }
  .sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: 255px;
    height: 100dvh;
    transform: translateX(-105%);
    transition: transform 0.22s;
    box-shadow: none;
  }
  .sidebar.is-open {
    transform: translateX(0);
  }
  .topbar {
    height: 58px;
    padding: 0 17px;
    gap: 12px;
  }
  .menu-toggle {
    display: grid;
  }
  .breadcrumb {
    margin-right: auto;
    font-size: 10px;
  }
