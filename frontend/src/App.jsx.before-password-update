                  <span className="brand-mark">N</span>
                  <span>northstar</span>
                </div>
                <div className="auth-heading">
                  <span className="eyebrow">
                    {authKind === "admin" && authMode === "register"
                      ? "ADMIN ACCESS"
                      : authMode === "register"
                        ? "GET STARTED"
                        : "WELCOME BACK"}
                  </span>
                  <h2>
                    {authKind === "admin" && authMode === "register"
                      ? "Create an admin account"
                      : authMode === "register"
                        ? "Open your account"
                        : "Sign in to your account"}
                  </h2>
                  <p>
                    {authKind === "admin" && authMode === "register"
                      ? "Create a privileged account using your admin creation key."
                      : authMode === "register"
                        ? "A few details and you’re ready to go."
                        : "Enter your details to continue."}
                  </p>
                </div>

                <div
                  className="auth-tabs"
                  role="tablist"
                  aria-label="Account access"
                >
                  {authTabs.map((tab) => (
                    <button
                      key={tab.key}
                      type="button"
                      className={`auth-tab ${authMode === tab.key ? "is-active" : ""}`}
                      onClick={() => {
                        setAuthMode(tab.key);
                        setAuthError("");
                      }}
                    >
                      {tab.label}
                    </button>
                  ))}
                </div>

                <form className="form-stack" onSubmit={handleAuthSubmit}>
                  {authMode === "register" && (
                    <label className="field">
                      <span>Full name</span>
                      <input
                        name="name"
                        autoComplete="name"
                        minLength={2}
                        placeholder="Your name"
                        required
                      />
                    </label>
                  )}

                  {authKind === "admin" && authMode === "register" && (
                    <label className="field">
                      <span>Admin creation key</span>
                      <input
                        name="adminCode"
                        type="password"
                        autoComplete="off"
                        placeholder="Enter your admin key"
                        required
                      />
                    </label>
                  )}

                  <label className="field">
                    <span>Email address</span>
                    <input
                      name="email"
                      type="email"
                      autoComplete="email"
                      required
                      placeholder="you@example.com"
                    />
                  </label>

                  <label className="field">
                    <span>Password</span>
                    <input
                      name="password"
                      type="password"
                      autoComplete={
                        authMode === "register"
                          ? "new-password"
                          : "current-password"
                      }
                      minLength={6}
                      required
                      placeholder="At least 6 characters"
                    />
                  </label>

                  {authError && (
                    <div className="notice" role="alert">
                      {authError}
                    </div>
                  )}

                  <button
                    className="button button-primary button-wide"
                    type="submit"
                  >
                    {authKind === "admin"
                      ? authMode === "register"
                        ? "Create admin account"
                        : "Sign in"
                      : authMode === "register"
                        ? "Create account"
                        : "Sign in"}{" "}
                  </button>
                </form>

                <button
                  type="button"
                  className="text-button admin-link"
                  onClick={() => {
                    setAuthKind((prev) =>
                      prev === "customer" ? "admin" : "customer",
                    );
                    setAuthError("");
                  }}
                >
                  {authKind === "admin"
                    ? "Back to customer access"
                    : "Create an admin account"}
                </button>

                <p className="fine-print">
                  By continuing, you agree to the terms that govern your
                  account.
                </p>
              </div>
            </div>
          </section>
        </main>
      ) : (
        <main>
          <section className="workspace" id="bank-view">
            <aside
              className={`sidebar ${menuOpen ? "is-open" : ""}`}
              id="sidebar"
            >
              <a
                className="brand"
                href="#overview"
                aria-label="Northstar overview"
              >
                <span className="brand-mark">N</span>
                <span>northstar</span>
              </a>
              <div className="side-label">YOUR MONEY</div>
              <nav className="main-nav" aria-label="Main navigation">
                {[
                  ["overview", "Overview"],
                  ["activity", "Activity"],
                  ["payments", "Move money"],
                  ["settings", "Account settings"],
                  ...(userRole === "admin" ? [["admin", "Admin"]] : []),
                ].map(([key, label]) => (
                  <button
                    key={key}
                    type="button"
                    className={`nav-item ${page === key ? "is-active" : ""}`}
                    onClick={() => {
                      handlePageChange(key);
                      setMenuOpen(false);
                    }}
                  >
                    <span className="nav-icon">
                      {key === "overview"
                        ? "◫"
                        : key === "activity"
                          ? "↗"
                          : key === "payments"
                            ? "⇄"
                            : key === "settings"
                              ? "◎"
                              : "⌘"}
                    </span>
                    {label}
                  </button>
                ))}
              </nav>

              <div className="sidebar-bottom">
                <div className="help-panel">
                  <span className="help-icon">?</span>
                  <div>
                    <strong>Need a hand?</strong>
                    <span>We're here to help.</span>
                  </div>
                  
                </div>
                <button
                  type="button"
                  className="profile-button"
                  onClick={() => handlePageChange("settings")}
                >
                  <span className="avatar">
                    {(userName || "N").charAt(0).toUpperCase()}
                  </span>
                  <span className="profile-copy">
                    <strong>{userName}</strong>
                    <small>{user?.email || ""}</small>
                  </span>
                  <span className="profile-dots">···</span>
                </button>
              </div>
            </aside>

            <section className="main-column">
              <header className="topbar">
                <button
                  className="icon-button menu-toggle"
                  type="button"
                  aria-label="Toggle menu"
                  aria-expanded={menuOpen}
                  aria-controls="sidebar"
                  onClick={() => setMenuOpen((isOpen) => !isOpen)}
                >
                  {menuOpen ? "×" : "☰"}
                </button>
                <div className="breadcrumb">
                  Personal banking <span>/</span>{" "}
                  <strong>
                    {page === "overview"
                      ? "Overview"
                      : page === "activity"
                        ? "Activity"
                        : page === "payments"
                          ? "Move money"
                          : page === "settings"
                            ? "Account settings"
                            : "Admin"}
                  </strong>
                </div>
                <div className="topbar-actions">
                  <span className="secure-tag">
                    <span className="signal-dot" /> Your account is secure
                  </span>
                  <button
                    type="button"
                    className="icon-button"
                    aria-label="Sign out"
                    onClick={() => {
                      clearSession();
                      setAuthMode("login");
                      setAuthKind("customer");
                    }}
                  >
                    ↗
                  </button>
                </div>
              </header>
              <div className="content">{pageContent}</div>
              <footer className="app-footer">
                <span>© 2026 Northstar Financial</span>
                <span>
                  <span className="signal-dot" /> All systems operational
                </span>
              </footer>
            </section>
          </section>
        </main>
      )}

      {toast && (
        <div
          className={`toast ${toastVisible ? "is-visible" : ""}`}
          role="status"
        >
          {toast}
        </div>
      )}

      {dialogOpen && (
        <dialog open className="action-dialog">
          <form onSubmit={handleActionSubmit}>
            <div className="dialog-top">
              <span className="eyebrow">
                {actionConfigs[dialogAction]?.eyebrow}
              </span>
              <button
                type="button"
                className="icon-button dialog-close"
                aria-label="Close"
                onClick={() => setDialogOpen(false)}
              >
                ×
              </button>
            </div>

            <h2>{actionConfigs[dialogAction]?.title}</h2>
            <p className="dialog-copy">{actionConfigs[dialogAction]?.copy}</p>

            <div className="form-stack">
              {dialogAction === "transfer" && (
                <>
                  <label className="field">
                    <span>Recipient account number</span>
                    <input
                      name="accountNumber"
                      placeholder="10-digit account number"
                      pattern="[0-9]{10}"
                      required
                    />
                  </label>
                  <label className="field">
                    <span>Amount</span>
                    <input
                      name="amount"
                      type="number"
                      min="0.01"
                      step="0.01"
                      placeholder="0.00"
                      required
                    />
                  </label>
                  <label className="field">
                    <span>Transaction PIN</span>
                    <input
                      name="pin"
                      type="password"
                      maxLength={4}
                      pattern="[0-9]{4}"
                      inputMode="numeric"
                      placeholder="4-digit PIN"
                      required
                    />
                  </label>
                </>
              )}

              {dialogAction === "deposit" && (
                <label className="field">
                  <span>Amount</span>
                  <input
                    name="amount"
                    type="number"
                    min="0.01"
                    step="0.01"
                    placeholder="0.00"
                    required
                  />
                </label>
              )}

              {dialogAction === "withdraw" && (
                <>
                  <label className="field">
                    <span>Amount</span>
                    <input
                      name="amount"
                      type="number"
                      min="0.01"
                      step="0.01"
                      placeholder="0.00"
                      required
                    />
                  </label>
                  <label className="field">
                    <span>Transaction PIN</span>
                    <input
                      name="pin"
                      type="password"
                      maxLength={4}
                      pattern="[0-9]{4}"
                      inputMode="numeric"
                      placeholder="4-digit PIN"
                      required
                    />
                  </label>
                </>
              )}

              {dialogAction === "pin" && (
                <label className="field">
                  <span>New transaction PIN</span>
                  <input
                    name="pin"
                    type="password"
                    maxLength={4}
                    pattern="[0-9]{4}"
                    inputMode="numeric"
                    placeholder="4 digits"
                    required
                  />
                </label>
              )}

              {dialogAction === "update-pin" && (
                <>
                  <label className="field">
                    <span>Current PIN</span>
                    <input
                      name="currentPin"
                      type="password"
                      maxLength={4}
                      pattern="[0-9]{4}"
                      inputMode="numeric"
                      placeholder="4 digits"
                      required
                    />
                  </label>
                  <label className="field">
                    <span>New PIN</span>
                    <input
                      name="newPin"
                      type="password"
                      maxLength={4}
                      pattern="[0-9]{4}"
                      inputMode="numeric"
                      placeholder="4 digits"
                      required
                    />
                  </label>
                </>
              )}

              {dialogAction === "admin-credit" && (
                <>
                  <label className="field">
                    <span>User ID</span>
                    <input
                      name="userId"
                      type="number"
                      min="1"
                      step="1"
                      placeholder="Account user ID"
                      required
                    />
                  </label>
                  <label className="field">
                    <span>Amount</span>
                    <input
                      name="amount"
                      type="number"
                      min="0.01"
                      step="0.01"
                      placeholder="0.00"
                      required
                    />
                  </label>
                </>
              )}
            </div>

            {dialogError && (
              <div className="dialog-error notice" role="alert">
                {dialogError}
              </div>
            )}

            <div className="dialog-actions">
              <button
                type="button"
                className="button button-quiet dialog-close"
                onClick={() => setDialogOpen(false)}
              >
                Cancel
              </button>
              <button className="button button-primary" type="submit">
                {actionConfigs[dialogAction]?.button}{" "}
              </button>
            </div>
          </form>
        </dialog>
      )}
    </>
  );
}

export default App;
